# Copy to .env and edit. Every value here is optional; these are the defaults.

# Where your private data (database + recordings) and downloaded models live.
GW_DATA_DIR=data
GW_MODELS_DIR=models

# ffmpeg command, or a full path to ffmpeg.exe if it isn't on PATH.
GW_FFMPEG_BIN=ffmpeg

# Local Ollama server and the Gemma model it serves. gemma4:e2b is faster on slow CPUs.
GW_OLLAMA_URL=http://127.0.0.1:11434
GW_LLM_MODEL=gemma4:e4b
GW_LLM_NUM_CTX=8192

# faster-whisper size: tiny | base | small | medium | large-v3. int8 suits CPUs.
GW_WHISPER_MODEL=small
GW_WHISPER_COMPUTE_TYPE=int8

# Feature flags.
GW_TTS_ENABLED=true
GW_PLAIN_MODE_DEFAULT=false
