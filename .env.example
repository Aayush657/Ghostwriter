# Copy to .env and edit. Every value here is optional; these are the defaults.

# Where your private data (database + recordings) and downloaded models live.
GW_DATA_DIR=data
GW_MODELS_DIR=models

# ffmpeg command, or a full path to ffmpeg.exe if it isn't on PATH. ffprobe (part of every ffmpeg
# build) checks uploads; it is found next to ffmpeg unless you give its path here.
GW_FFMPEG_BIN=ffmpeg
GW_FFPROBE_BIN=
# Recordings longer than this are refused before anything is saved.
GW_MAX_AUDIO_MINUTES=30

# Local Ollama server and the Gemma model it serves. gemma4:e2b is faster on slow CPUs.
GW_OLLAMA_URL=http://127.0.0.1:11434
GW_LLM_MODEL=gemma4:e4b
GW_LLM_NUM_CTX=8192
# Optional: lets the Seance find stories by meaning, not only by shared words.
# Pull it once with: ollama pull embeddinggemma:300m-qat-q8_0
GW_EMBED_MODEL=embeddinggemma:300m-qat-q8_0

# faster-whisper size. Ghostwriter listens in English, so the English-only ".en" sizes fit best:
# tiny.en | base.en | small.en | medium.en (tiny | base | small | medium | large-v3-turbo | large-v3 work too).
# Bigger hears names and numbers better but is slower and needs more memory (README > Whisper size).
# After changing it, run scripts\setup.ps1 once to download that size. int8 suits CPUs.
GW_WHISPER_MODEL=small.en
GW_WHISPER_COMPUTE_TYPE=int8

# The ghost voice (optional). Piper's program, and a voice file name in models/piper/.
GW_TTS_ENABLED=true
GW_PIPER_BIN=piper
GW_PIPER_VOICE=en_GB-northern_english_male-medium

# Start in plain mode (neutral wording, no effects) instead of the Archivist's voice.
GW_PLAIN_MODE_DEFAULT=false
